# Auto detect text files and perform LF normalization
* text=auto

# Enforce LF line endings for cross-platform scientific reproducibility
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.toml text eol=lf
*.cff text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.zip binary
*.tar.gz binary
*.db binary
*.sqlite3 binary
